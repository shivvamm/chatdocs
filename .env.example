# =============================================================================
# ChatDocs Environment Variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# NEVER commit the .env file to version control.
# =============================================================================

# --- LLM & Embeddings ---
GROQ_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
LANGCHAIN_API_KEY=
DEEP_INFRA_API_KEY=

# --- Database ---
MYSQL_URI=mysql+pymysql://root:yourpassword@host.docker.internal:3306/chatbotserver

# --- Auth ---
JWT_SECRET_KEY=generate_a_random_256bit_hex_string

# --- Redis ---
REDIS_URL=redis://redis-server:6379/0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- Email (Mailjet) ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# --- Email (SendGrid, alternative) ---
SENDGRID_API_KEY=

# --- Sender Email ---
SENDER=your-email@example.com

# --- Email Verification (Hunter.io, optional) ---
HUNTER_API_KEY=
